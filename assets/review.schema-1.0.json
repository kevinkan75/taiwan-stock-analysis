{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared stock/ETF workflow review 1.0",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https?://[^\\s]+|attachment:[^\\s]+)$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_type": {
          "enum": [
            "quote",
            "company_announcement",
            "financial_statement",
            "monthly_revenue",
            "preliminary_results",
            "company_guidance",
            "external_estimate",
            "analysis_assumption",
            "other"
          ]
        }
      },
      "required": [
        "url",
        "title",
        "published_at",
        "retrieved_at",
        "source_type"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "snapshot_type": {
      "const": "review"
    },
    "schema_version": {
      "const": "1.0"
    },
    "model_version": {
      "const": "review-1.0"
    },
    "skill_version": {
      "type": "string",
      "minLength": 1
    },
    "rule_version": {
      "type": "string",
      "minLength": 1
    },
    "validator_version": {
      "const": "1.0.0"
    },
    "security": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "exchange": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "instrument": {
          "enum": [
            "ordinary",
            "adr",
            "etf"
          ]
        }
      },
      "required": [
        "name",
        "symbol",
        "exchange",
        "currency",
        "instrument"
      ],
      "additionalProperties": false
    },
    "analysis_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_cutoff_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "research",
        "decision"
      ]
    },
    "research_reference": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rule_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reference",
        "sha256",
        "rule_version",
        "model_version"
      ],
      "additionalProperties": false
    },
    "decision_reference": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "rule_version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "model_version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "reference",
            "sha256",
            "rule_version",
            "model_version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "obtained",
              "not_run",
              "partial",
              "not_published",
              "access_failed",
              "conflicting",
              "incompatible",
              "not_applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "stage": {
                  "enum": [
                    "primary",
                    "alternative",
                    "calculation"
                  ]
                },
                "source_url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "request": {
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "enum": [
                    "success",
                    "unavailable",
                    "blocked",
                    "conflict",
                    "incompatible"
                  ]
                },
                "detail": {
                  "type": "string",
                  "minLength": 1
                },
                "authority_basis": {
                  "type": "string"
                }
              },
              "required": [
                "stage",
                "source_url",
                "at",
                "request",
                "result",
                "detail",
                "authority_basis"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "status",
          "reason",
          "attempts"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "assessment": {
      "type": "object",
      "properties": {
        "workflow_status": {
          "enum": [
            "incomplete",
            "complete"
          ]
        },
        "evidence_status": {
          "enum": [
            "sufficient",
            "insufficient"
          ]
        },
        "pending_tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolved_tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "waiting_reasons": {
          "type": "array",
          "items": {
            "enum": [
              "data_pending",
              "event_pending",
              "price_conditions",
              "risk_conditions"
            ]
          }
        },
        "research_confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            null
          ]
        },
        "primary_source_count": {
          "type": "integer",
          "minimum": 0
        },
        "alternative_source_count": {
          "type": "integer",
          "minimum": 0
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "workflow_status",
        "evidence_status",
        "pending_tasks",
        "unresolved_tasks",
        "waiting_reasons",
        "research_confidence",
        "primary_source_count",
        "alternative_source_count",
        "attempt_count"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "snapshot_type",
    "schema_version",
    "model_version",
    "skill_version",
    "rule_version",
    "validator_version",
    "security",
    "analysis_at",
    "data_cutoff_at",
    "mode",
    "research_reference",
    "decision_reference",
    "tasks",
    "sources",
    "assessment"
  ],
  "additionalProperties": false
}
