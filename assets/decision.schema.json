{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision conclusion records 1.1; numeric gates and manually assessed evidence",
  "description": "Verifies conclusion selection, provenance and report rows. Numeric inputs, conclusions and explicit report claims are checked; external evidence is not verified.",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https?://[^\\s]+|attachment:[^\\s]+)$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_type": {
          "enum": [
            "quote",
            "company_announcement",
            "financial_statement",
            "monthly_revenue",
            "preliminary_results",
            "company_guidance",
            "external_estimate",
            "analysis_assumption",
            "other"
          ]
        }
      },
      "required": [
        "url",
        "title",
        "published_at",
        "retrieved_at",
        "source_type"
      ],
      "additionalProperties": false
